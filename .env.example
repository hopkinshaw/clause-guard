OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini


# Server-side Postgres configuration. The app prefers DATABASE_URL, then POSTGRES_URL.
# Neon migrations prefer DATABASE_URL_UNPOOLED when available. PGHOST/PGUSER/PGDATABASE/PGPASSWORD/PGPORT also work.
DATABASE_URL=
# Optional canonical site origin. If empty, use the origin of the incoming request.
APP_URL=http://localhost:3000
BILLING_COOKIE_SECRET=
# Free allowances can be reduced to 0 or 1. The maximum is 2.
FREE_ANALYSIS_CREDITS=2
FREE_ANALYSIS_DAILY_LIMIT=100
ANALYSIS_DAILY_LIMIT=300
# Optional JSON array. Amounts are in USD cents.
BILLING_PACKS=[{"id":"starter","credits":5,"amount":499},{"id":"plus","credits":10,"amount":899}]

# Hosted Stripe Checkout. Keep both keys server-side.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
